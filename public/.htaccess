# Apache config for the static export build (`SEO=false` -> `npm run build` -> out/).
# Generated by scripts/generate-htaccess.mjs (runs via the "prebuild" npm hook) —
# edit that script, not this file directly, it gets overwritten on every build.
# Not used/needed for the standalone/VPS build (SEO=true) — that runs Node directly.


Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /

# No server exists to detect the visitor's locale under static export (the
# Proxy that does this in SEO=true mode is an unsupported static-export
# feature) — serve the default locale's shared build directly at "/",
# internally, so the URL never shows "/en". Client-side
# code treats an unresolved lang param as the default locale already
# (see locale-link.tsx), so this degrades cleanly.
RewriteRule ^$ /%5Blang%5D.html [L]

# Serve a real file exactly as requested (e.g. /_next/static/..., /favicon.ico).
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Prefer a route's own flat "<path>.html" export over letting Apache try to
# list/serve the same-named directory of per-route asset chunks — only
# matters for a route that ships real per-locale content (none currently;
# kept generic in case one shows up again).
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*[^/])/?$ $1.html [L]

# Routes with a real (unbounded, backend-driven) dynamic segment -> the
# shared build's literal bracket-named file. The client reads the real
# locale and slug from the live browser URL, not this rewrite target.
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/service-details/.*$ /%5Blang%5D/service-details/%5B...slug%5D.html [L]
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/provider-details/.*$ /%5Blang%5D/provider-details/%5B...slug%5D.html [L]
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/booking/.*$ /%5Blang%5D/booking/%5B...slug%5D.html [L]
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/my-service-request-details/.*$ /%5Blang%5D/my-service-request-details/%5B...slug%5D.html [L]
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/blog-details/.*$ /%5Blang%5D/blog-details/%5Bslug%5D.html [L]
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/custom-page/.*$ /%5Blang%5D/custom-page/%5Bslug%5D.html [L]
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/search/.*$ /%5Blang%5D/search/%5Bslug%5D.html [L]
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/chats/.*$ /%5Blang%5D/chats/%5B%5B...chatId%5D%5D.html [L]

# Locale root (e.g. "/en/", "/en") -> the shared build's own root export.
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/?$ /%5Blang%5D.html [L]

# Everything else under a locale prefix (static/placeholder routes with no
# dynamic segment) -> the shared "[lang]" build.
RewriteRule ^[a-z]{2}(-[A-Z]{2})?/(.*)$ /%5Blang%5D/$2.html [L]

ErrorDocument 404 /404.html
